{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"SKILL_DIR/scripts/stop.mjs\"", "timeout": 15 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"SKILL_DIR/scripts/brief.mjs\"", "timeout": 10 }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"SKILL_DIR/scripts/statusline.mjs\"",
    "padding": 0
  }
}
